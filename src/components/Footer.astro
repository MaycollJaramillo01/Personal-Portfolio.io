---
import { SITE } from '../config/site';
import { NAV_LINKS } from '../data/navigation';

interface Props {
  lang?: 'es' | 'en';
}

const lang = Astro.props.lang ?? 'es';
const links = NAV_LINKS[lang];
const secondaryLinks = [
  { href: '/privacy', label: lang === 'es' ? 'Privacidad' : 'Privacy' },
  { href: '/terms', label: lang === 'es' ? 'Términos' : 'Terms' }
];
---

<footer class="border-t border-border/70 bg-panel/60 py-10 text-sm text-muted">
  <div class="mx-auto flex max-w-6xl flex-col gap-10 px-4 md:flex-row md:justify-between md:px-6">
    <div class="max-w-md space-y-3">
      <p class="text-xs uppercase tracking-[0.15em] text-accent">
        {lang === 'es' ? 'Contacto directo' : 'Direct contact'}
      </p>
      <p class="text-lg font-semibold text-foreground">Maycoll de Jesús Jaramillo Vanegas</p>
      <ul class="space-y-2">
        <li>
          <a class="inline-flex items-center gap-2 text-foreground transition hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href={`mailto:${SITE.email}`}>
            {SITE.email}
          </a>
        </li>
        <li>
          <a class="inline-flex items-center gap-2 text-foreground transition hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href={`tel:${SITE.phone.replace(/\s+/g, '')}`}>
            {SITE.phone}
          </a>
        </li>
        <li class="text-foreground/80">{SITE.location} · {lang === 'es' ? 'Remoto LATAM/USA/ES' : 'Remote LATAM/USA/ES'}</li>
      </ul>
      <div class="flex gap-3">
        <a class="rounded-full border border-border/70 px-3 py-2 text-foreground transition hover:border-accent hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href={SITE.social.linkedin} target="_blank" rel="noopener">
          LinkedIn
        </a>
        <a class="rounded-full border border-border/70 px-3 py-2 text-foreground transition hover:border-accent hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href={SITE.social.github} target="_blank" rel="noopener">
          GitHub
        </a>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-8 md:grid-cols-3">
      <div>
        <p class="text-xs uppercase tracking-[0.15em] text-accent">Site</p>
        <ul class="mt-3 space-y-2">
          {links.map((item) => (
            <li>
              <a class="text-foreground/80 transition hover:text-foreground focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <p class="text-xs uppercase tracking-[0.15em] text-accent">{lang === 'es' ? 'Legal' : 'Trust'}</p>
        <ul class="mt-3 space-y-2">
          {secondaryLinks.map((item) => (
            <li>
              <a class="text-foreground/80 transition hover:text-foreground focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <p class="text-xs uppercase tracking-[0.15em] text-accent">{lang === 'es' ? 'Disponibilidad' : 'Availability'}</p>
        <ul class="mt-3 space-y-2 text-foreground/80">
          <li>{lang === 'es' ? 'Respondo en menos de 24h hábiles' : 'Replies in under 24h (business)'}</li>
          <li>{lang === 'es' ? 'Proyectos: Shopify, WordPress, Astro' : 'Projects: Shopify, WordPress, Astro'}</li>
          <li>{lang === 'es' ? 'Consultoría técnica SEO / Accesibilidad' : 'Technical SEO / Accessibility consulting'}</li>
        </ul>
      </div>
    </div>
  </div>
  <div class="mx-auto mt-8 flex max-w-6xl flex-col gap-2 px-4 text-xs text-muted/80 md:flex-row md:items-center md:justify-between md:px-6">
    <p>© {new Date().getFullYear()} Maycoll de Jesús Jaramillo Vanegas</p>
    <p>{lang === 'es' ? 'Construido con Astro, Tailwind y buenas prácticas CWV/SEO/Accesibilidad.' : 'Built with Astro, Tailwind, and WCAG/SEO/CWV best practices.'}</p>
  </div>
</footer>
