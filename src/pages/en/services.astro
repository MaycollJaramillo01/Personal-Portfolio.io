---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CONTACT_CTA } from '../../config/site';
import { breadcrumbJsonLd } from '../../lib/seo';

const services = [
  {
    title: 'Technical delivery',
    items: [
      'Astro/Shopify/WordPress builds with CWV and accessibility baked in.',
      'Shopify Liquid themes without unnecessary apps and with clean tracking.',
      'Custom WordPress with hardening, coherent caching, and content guidelines.'
    ]
  },
  {
    title: 'Technical SEO & structured data',
    items: [
      'Sitemap architecture + ES/EN hreflang, canonicals, and correct pagination.',
      'JSON-LD for Person, WebSite, ProfilePage, and BreadcrumbList per template.',
      'Indexation audits and thin content cleanup.'
    ]
  },
  {
    title: 'Accessibility and robust UX',
    items: [
      'Accessible patterns for navigation, filters, carts, and checkouts.',
      'Visible focus states; roles/aria only when needed.',
      'WCAG AA/AAA checks on critical flows with guidance for teams.'
    ]
  },
  {
    title: 'Measurement and automation',
    items: [
      'GA4 + Pixel setups without duplicates or render-blocking scripts.',
      'Automations with GHL/WhatsApp Business API respecting opt-in and logging.',
      'Light dashboards and alerts for CWV and conversions.'
    ]
  }
];

const structuredData = [
  breadcrumbJsonLd([
    { name: 'Home', path: '/en' },
    { name: 'Services', path: '/en/services' }
  ])
];
---

<BaseLayout
  lang="en"
  title="Services | Performance, Technical SEO, Accessibility"
  description="Implementation and consulting across Shopify, WordPress, and Astro with CWV, accessibility, and conversion measurement."
  canonicalPath="/en/services"
  alternates={[{ lang: 'es', path: '/es/services' }]}
  structuredData={structuredData}
>
  <section class="mx-auto max-w-5xl px-4 py-12 md:px-6">
    <p class="text-xs uppercase tracking-[0.2em] text-accent">Services</p>
    <h1 class="mt-2 text-3xl font-semibold text-foreground">Senior delivery and consulting</h1>
    <p class="mt-4 text-muted">
      I deliver business-ready sites: fast, accessible, and measurable. I work with teams that need clear outcomes and documentation to operate without friction.
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-12 md:px-6">
    <h2 class="text-2xl font-semibold text-foreground">Offerings</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {services.map((service) => (
        <article class="card p-5">
          <h3 class="text-lg font-semibold text-foreground">{service.title}</h3>
          <ul class="mt-3 space-y-2 text-muted">
            {service.items.map((item) => (
              <li class="flex items-start gap-2">
                <span class="mt-1 inline-block h-2 w-2 rounded-full bg-accent"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-12 md:px-6">
    <h2 class="text-2xl font-semibold text-foreground">Working principles</h2>
    <div class="mt-4 grid gap-4 md:grid-cols-2">
      <div class="card p-5">
        <p class="font-semibold text-foreground">No fluff</p>
        <p class="mt-2 text-muted">Engineering backed by metrics and clear acceptance criteria.</p>
      </div>
      <div class="card p-5">
        <p class="font-semibold text-foreground">Accessibility first</p>
        <p class="mt-2 text-muted">Accessible patterns for critical components with visible focus and keyboard support.</p>
      </div>
      <div class="card p-5">
        <p class="font-semibold text-foreground">Architecture-led SEO</p>
        <p class="mt-2 text-muted">Hreflang, canonicals, schema, and sitemaps integrated at the core.</p>
      </div>
      <div class="card p-5">
        <p class="font-semibold text-foreground">Performance by default</p>
        <p class="mt-2 text-muted">CWV measured per delivery and no unnecessary dependencies.</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-16 md:px-6">
    <div class="card flex flex-col gap-4 p-6 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="text-xs uppercase tracking-[0.2em] text-accent">Next</p>
        <h2 class="text-xl font-semibold text-foreground">Share your context</h2>
        <p class="mt-2 max-w-2xl text-muted">
          In a call we review your stack, current metrics, and define an action plan with clear priorities.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a
          class="inline-flex items-center justify-center rounded-full bg-accent px-4 py-2 text-sm font-semibold text-surface shadow-soft transition hover:bg-accent-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-surface"
          href={CONTACT_CTA.primary.href}
        >
          Book a call
        </a>
        <a
          class="inline-flex items-center justify-center rounded-full border border-border/70 bg-panel px-4 py-2 text-sm font-semibold text-foreground transition hover:border-accent hover:text-foreground focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          href="/work"
        >
          View work
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
